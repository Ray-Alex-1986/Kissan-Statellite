NODE_ENV=development
PORT=5000

# Database (defaults match docker-compose)
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=farmportal
DB_USER=farmportal
DB_PASSWORD=farmportal

JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# Data providers: mock | sentinel-hub  (mock = synthetic demo data, no credentials needed)
SATELLITE_PROVIDER=mock
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# Data providers: mock | soilgrids  (mock = synthetic demo soil profile)
SOIL_PROVIDER=mock
SOILGRIDS_WCS_URL=https://maps.isric.org/mapserv?map=/map/wcs.map

# Weather provider: open-meteo (free for non-commercial use, no API key) | mock
WEATHER_PROVIDER=open-meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com
# Cache TTLs (minutes) — historical observations are fetched once and reused.
WEATHER_CURRENT_CACHE_MINUTES=30
WEATHER_FORECAST_CACHE_MINUTES=60

# Demo seeding
SEED_DEMO_DATA=true
